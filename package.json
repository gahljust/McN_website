{
  "name": "mcnulty-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Dr. McNulty's Physics Lab at Idaho State University",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/prepare-content.mjs && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "prepare:content": "node scripts/prepare-content.mjs",
    "typecheck": "node scripts/prepare-content.mjs && next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gahljust/McN_website.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gahljust/McN_website/issues"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "nextra": "4.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "overrides": {
    "gray-matter": { "js-yaml": "3.15.2" },
    "@ts-morph/common": { "minimatch": "11.0.5" },
    "katex": "0.18.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "mdast-util-to-string": "4.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "typescript": "5.9.3",
    "unified": "11.0.5"
  }
}
